+Section CallbackRefinement.
+  Context {rule witness : Type}.
+  Variables e1 e2 : rule -> list C.t -> option C.t.
+  Variables g1 g2 : list C.t -> C.t -> witness -> bool.
+  Hypothesis He : forall p cs, e1 p cs = e2 p cs.
+  Hypothesis Hg : forall cs c w, g1 cs c w = g2 cs c w.
+
+  Lemma check_step_refine : forall nf m st,
+    EunoiaChecker.check_step e1 g1 nf m st = EunoiaChecker.check_step e2 g2 nf m st.
+  Proof.
+    intros; unfold EunoiaChecker.check_step.
+    destruct (EunoiaChecker.fetch m (EunoiaChecker.premises st)); [|reflexivity].
+    rewrite He; destruct (e2 (EunoiaChecker.payload st) l); [|reflexivity].
+    now rewrite Hg.
+  Qed.
+
+  Lemma run_refine : forall nf m ts,
+    EunoiaChecker.run e1 g1 nf m ts = EunoiaChecker.run e2 g2 nf m ts.
+  Proof.
+    intros nf m ts; revert m; induction ts; intro m; simpl; [reflexivity|].
+    rewrite check_step_refine.
+    destruct (EunoiaChecker.check_step e2 g2 nf m a); [apply IHts|reflexivity].
+  Qed.
+
+  Lemma checker_refine : forall nf capacity roots claims ts goal,
+    EunoiaChecker.checker e1 g1 nf capacity roots claims ts goal =
+    EunoiaChecker.checker e2 g2 nf capacity roots claims ts goal.
+  Proof.
+    intros; unfold EunoiaChecker.checker.
+    destruct (EunoiaChecker.load_roots nf (EunoiaChecker.initial capacity) roots claims);
+      [now rewrite run_refine|reflexivity].
+  Qed.
+End CallbackRefinement.
+
+Print Assumptions check_step_refine.
+Print Assumptions run_refine.
+Print Assumptions checker_refine.
+
 End EunoiaChecker.
