+Section ScopedCallbackRefinement.
+  Context {rule scope_rule witness : Type}.
+  Variables e1 e2 : rule -> list C.t -> option C.t.
+  Variables s1 s2 : scope_rule -> _lit -> C.t -> option C.t.
+  Variables g1 g2 : list C.t -> C.t -> witness -> bool.
+  Hypothesis He : forall p cs, e1 p cs = e2 p cs.
+  Hypothesis Hs : forall p a c, s1 p a c = s2 p a c.
+  Hypothesis Hg : forall cs c w, g1 cs c w = g2 cs c w.
+
+  Lemma close_refine : forall nf parent local a d,
+    EunoiaScope.close s1 g1 nf parent local a d =
+    EunoiaScope.close s2 g2 nf parent local a d.
+  Proof.
+    intros; unfold EunoiaScope.close.
+    destruct (EunoiaChecker.fetch local [EunoiaScope.endpoint d]) as [cs|]; [|reflexivity].
+    destruct cs as [|c [|x cs]]; try reflexivity.
+    rewrite Hs; destruct (s2 (EunoiaScope.scope_payload d) a c); [|reflexivity].
+    now rewrite Hg.
+  Qed.
+
+  Lemma scope_run_refine : forall nf m t,
+    EunoiaScope.run e1 s1 g1 nf m t = EunoiaScope.run e2 s2 g2 nf m t.
+  Proof.
+    intros nf m t; revert m.
+    induction t as [|st rest IH|slot a body IHb closing rest IHr]; intro m; simpl.
+    - reflexivity.
+    - rewrite (check_step_refine e1 e2 g1 g2 He Hg).
+      destruct (EunoiaChecker.check_step e2 g2 nf m st); [apply IH|reflexivity].
+    - destruct closing; [|reflexivity].
+      destruct (EunoiaChecker.store nf m slot [a]); [|reflexivity].
+      rewrite IHb; destruct (EunoiaScope.run e2 s2 g2 nf m0 body); [|reflexivity].
+      rewrite close_refine; destruct (EunoiaScope.close s2 g2 nf m m1 a d);
+        [apply IHr|reflexivity].
+  Qed.
+
+  Lemma scope_checker_refine : forall nf capacity roots claims t goal,
+    EunoiaScope.checker e1 s1 g1 nf capacity roots claims t goal =
+    EunoiaScope.checker e2 s2 g2 nf capacity roots claims t goal.
+  Proof.
+    intros; unfold EunoiaScope.checker.
+    destruct (EunoiaChecker.load_roots nf (EunoiaChecker.initial capacity) roots claims);
+      [now rewrite scope_run_refine|reflexivity].
+  Qed.
+End ScopedCallbackRefinement.
+
+Print Assumptions close_refine.
+Print Assumptions scope_run_refine.
+Print Assumptions scope_checker_refine.
+
 End EunoiaScope.
