unsat
(
(declare-const x Int)
(define @t1 () (* 2 x))
(define @t2 () (= @t1 1))
(define @t3 () (to_real x))
(define @t4 () (to_real 1))
(define @t5 () (to_real @t1))
(define @t6 () (- @t5 @t4))
(define @t7 () (= @t5 @t4))
(assume @p1 @t2)
(step @p2 :rule evaluate :args ((= (to_real (to_int 1/2)) 1/2)))
(step @p3 :rule arith-int-eq-conflict :premises (@p2) :args (x 1/2))
(step @p4 :rule arith_poly_norm :args ((= (* -1/2 @t6) (* -1/1 (- @t3 1/2)))))
(step @p5 :rule arith_poly_norm_rel :premises (@p4) :args ((= @t7 (= @t3 1/2))))
(step @p6 :rule arith_poly_norm :args ((= (* -1/1 (to_real (- @t1 1))) (* -1/1 @t6))))
(step @p7 :rule arith_poly_norm_rel :premises (@p6) :args ((= @t2 @t7)))
(step @p8 :rule trans :premises (@p7 @p5 @p3))
(step @p9 false :rule eq_resolve :premises (@p1 @p8))
)
