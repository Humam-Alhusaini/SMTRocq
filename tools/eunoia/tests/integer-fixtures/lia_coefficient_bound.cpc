unsat
(
(declare-const x Int)
(define @t1 () (* 2 x))
(define @t2 () (* -1 x))
(define @t3 () (+ x 1))
(define @t4 () (to_int -3/2))
(define @t5 () (to_real @t2))
(assume @p1 (<= @t1 3))
(assume @p2 (>= x 2))
(step @p3 :rule arith_poly_norm :args ((= (* 1 (- 2 @t3)) (* 1 (- @t2 -1)))))
(step @p4 :rule arith_poly_norm_rel :premises (@p3) :args ((= (>= 2 @t3) (>= @t2 -1))))
(step @p5 :rule arith-geq-tighten :args (x 2))
(step @p6 :rule trans :premises (@p5 @p4))
(step @p7 :rule symm :premises (@p6))
(step @p8 :rule evaluate :args ((+ @t4 1)))
(step @p9 :rule symm :premises (@p8))
(step @p10 :rule evaluate :args ((= (to_real @t4) -3/2)))
(step @p11 :rule arith-int-geq-tighten :premises (@p10 @p9) :args (@t2 -3/2 -1))
(step @p12 :rule arith_poly_norm :args ((= (* 3/2 (to_real (- 3 @t1))) (* 3/1 (- @t5 -3/2)))))
(step @p13 :rule arith_poly_norm_rel :premises (@p12) :args ((= (>= 3 @t1) (>= @t5 -3/2))))
(step @p14 :rule trans :premises (@p13 @p11 @p7))
(step @p15 :rule arith-elim-leq :args (@t1 3))
(step @p16 :rule trans :premises (@p15 @p14))
(step @p17 :rule eq_resolve :premises (@p1 @p16))
(step @p18 false :rule contra :premises (@p2 @p17))
)
