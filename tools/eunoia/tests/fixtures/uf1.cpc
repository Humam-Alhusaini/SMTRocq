unsat
(
(declare-sort U 0)
(declare-const c U)
(declare-const f (-> U U))
(declare-const a U)
(declare-const p (-> U Bool))
(declare-const b U)
(define @t1 () (p b))
(define @t2 () (not @t1))
(define @t3 () (p a))
(define @t4 () (and @t3 @t2))
(define @t5 () (f b))
(define @t6 () (f a))
(define @t7 () (= @t6 @t5))
(define @t8 () (not @t7))
(define @t9 () (or @t8 @t4))
(define @t10 () (p c))
(define @t11 () (and @t10 (not @t10)))
(define @t12 () (f c))
(define @t13 () (not (= @t12 @t12)))
(assume @p1 (and (= a c) (= b c) @t9))
(step @p2 :rule aci_norm :args ((= (or false @t11) @t11)))
(step @p3 :rule refl :args (@t11))
(step @p4 :rule evaluate :args ((not true)))
(step @p5 :rule eq-refl :args (@t12))
(step @p6 :rule cong :premises (@p5) :args (@t13))
(step @p7 :rule trans :premises (@p6 @p4))
(step @p8 :rule nary_cong :premises (@p7 @p3) :args ((or @t13 @t11)))
(step @p9 :rule trans :premises (@p8 @p2))
(step @p10 :rule and_elim :premises (@p1) :args (1))
(step @p11 :rule cong :premises (@p10) :args (@t1))
(step @p12 :rule cong :premises (@p11) :args (@t2))
(step @p13 :rule and_elim :premises (@p1) :args (0))
(step @p14 :rule cong :premises (@p13) :args (@t3))
(step @p15 :rule nary_cong :premises (@p14 @p12) :args (@t4))
(step @p16 :rule cong :premises (@p10) :args (@t5))
(step @p17 :rule cong :premises (@p13) :args (@t6))
(step @p18 :rule cong :premises (@p17 @p16) :args (@t7))
(step @p19 :rule cong :premises (@p18) :args (@t8))
(step @p20 :rule nary_cong :premises (@p19 @p15) :args (@t9))
(step @p21 :rule trans :premises (@p20 @p9))
(step @p22 :rule and_elim :premises (@p1) :args (2))
(step @p23 :rule eq_resolve :premises (@p22 @p21))
(step @p24 :rule and_elim :premises (@p23) :args (0))
(step @p25 :rule and_elim :premises (@p23) :args (1))
(step @p26 false :rule chain_m_resolution :premises (@p25 @p24) :args (false (@list false) (@list @t10)))
)
