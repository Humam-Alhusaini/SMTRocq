unsat
(
(declare-sort U 0)
(declare-const f (-> U U))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (= x y))
(define @t2 () (f z))
(define @t3 () (f x))
(define @t4 () (f y))
(define @t5 () (= @t3 @t4))
(define @t6 () (not @t5))
(assume @p1 (and @t6 (= y z) (= @t3 (f @t2)) @t1))
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (@t2))
(step @p4 :rule cong :premises (@p3) :args ((not (= @t2 @t2))))
(step @p5 :rule trans :premises (@p4 @p2))
(step @p6 :rule and_elim :premises (@p1) :args (1))
(step @p7 :rule cong :premises (@p6) :args (@t4))
(step @p8 :rule cong :premises (@p6) :args (@t1))
(step @p9 :rule and_elim :premises (@p1) :args (3))
(step @p10 :rule eq_resolve :premises (@p9 @p8))
(step @p11 :rule cong :premises (@p10) :args (@t3))
(step @p12 :rule cong :premises (@p11 @p7) :args (@t5))
(step @p13 :rule cong :premises (@p12) :args (@t6))
(step @p14 :rule trans :premises (@p13 @p5))
(step @p15 :rule and_elim :premises (@p1) :args (0))
(step @p16 false :rule eq_resolve :premises (@p15 @p14))
)
