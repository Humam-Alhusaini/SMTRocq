unsat
(
(declare-const op_0 Int)
(declare-const op_1 Int)
(define @t1 () (- op_1 1))
(define @t2 () (<= op_0 @t1))
(define @t3 () (= (< op_0 op_1) @t2))
(define @t4 () (not (= @t3 true)))
(define @t5 () (+ op_1 (* -1 op_0)))
(define @t6 () (>= @t5 1))
(define @t7 () (+ -1 op_1))
(define @t8 () (* -1 1))
(define @t9 () (+ op_1 @t8))
(define @t10 () (+ @t5 1))
(define @t11 () (>= op_0 op_1))
(assume @p1 @t4)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (@t6))
(step @p4 :rule arith_poly_norm :args ((= (* -1 (- @t7 op_0)) (* -1 (- @t5 1)))))
(step @p5 :rule arith_poly_norm_rel :premises (@p4) :args ((= (>= @t7 op_0) @t6)))
(step @p6 :rule arith-elim-leq :args (op_0 @t7))
(step @p7 :rule trans :premises (@p6 @p5))
(step @p8 :rule arith_poly_norm :args ((= (+ op_1 -1) @t7)))
(step @p9 :rule evaluate :args (@t8))
(step @p10 :rule refl :args (op_1))
(step @p11 :rule nary_cong :premises (@p10 @p9) :args (@t9))
(step @p12 :rule trans :premises (@p11 @p8))
(step @p13 :rule arith_poly_norm :args ((= @t1 @t9)))
(step @p14 :rule trans :premises (@p13 @p12))
(step @p15 :rule cong :premises (@p14) :args (@t2))
(step @p16 :rule trans :premises (@p15 @p7))
(step @p17 :rule bool-double-not-elim :args (@t6))
(step @p18 :rule arith_poly_norm :args ((= (* -1 (- 1 @t10)) (* -1 (- op_0 op_1)))))
(step @p19 :rule arith_poly_norm_rel :premises (@p18) :args ((= (>= 1 @t10) @t11)))
(step @p20 :rule arith-geq-tighten :args (@t5 1))
(step @p21 :rule trans :premises (@p20 @p19))
(step @p22 :rule symm :premises (@p21))
(step @p23 :rule cong :premises (@p22) :args ((not @t11)))
(step @p24 :rule trans :premises (@p23 @p17))
(step @p25 :rule arith-elim-lt :args (op_0 op_1))
(step @p26 :rule trans :premises (@p25 @p24))
(step @p27 :rule cong :premises (@p26 @p16) :args (@t3))
(step @p28 :rule trans :premises (@p27 @p3))
(step @p29 :rule bool-eq-true :args (@t3))
(step @p30 :rule trans :premises (@p29 @p28))
(step @p31 :rule cong :premises (@p30) :args (@t4))
(step @p32 :rule trans :premises (@p31 @p2))
(step @p33 false :rule eq_resolve :premises (@p1 @p32))
)
