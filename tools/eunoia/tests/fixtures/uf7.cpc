unsat
(
(declare-sort U 0)
(declare-const P (-> U U Bool))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (P z x))
(define @t2 () (P z y))
(assume @p1 (= x y))
(assume @p2 @t1)
(assume @p3 (not @t2))
(step @p4 :rule cong :premises (@p1) :args (@t1))
(step @p5 :rule eq_resolve :premises (@p2 @p4))
(step @p6 false :rule chain_m_resolution :premises (@p3 @p5) :args (false (@list false) (@list @t2)))
)
