unsat
(
(declare-sort U 0)
(declare-const b U)
(declare-const d U)
(declare-const c U)
(declare-const e U)
(declare-const a U)
(declare-const f U)
(define @t1 () (= a f))
(define @t2 () (not @t1))
(define @t3 () (= c e))
(assume @p1 (and (= a b) (= b c) (= c d) @t3 (= e f) @t2))
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (f))
(step @p4 :rule cong :premises (@p3) :args ((not (= f f))))
(step @p5 :rule trans :premises (@p4 @p2))
(step @p6 :rule refl :args (f))
(step @p7 :rule and_elim :premises (@p1) :args (4))
(step @p8 :rule refl :args (e))
(step @p9 :rule and_elim :premises (@p1) :args (2))
(step @p10 :rule cong :premises (@p9 @p8) :args (@t3))
(step @p11 :rule and_elim :premises (@p1) :args (3))
(step @p12 :rule eq_resolve :premises (@p11 @p10))
(step @p13 :rule trans :premises (@p12 @p7))
(step @p14 :rule trans :premises (@p9 @p13))
(step @p15 :rule and_elim :premises (@p1) :args (1))
(step @p16 :rule trans :premises (@p15 @p14))
(step @p17 :rule and_elim :premises (@p1) :args (0))
(step @p18 :rule trans :premises (@p17 @p16))
(step @p19 :rule cong :premises (@p18 @p6) :args (@t1))
(step @p20 :rule cong :premises (@p19) :args (@t2))
(step @p21 :rule trans :premises (@p20 @p5))
(step @p22 :rule and_elim :premises (@p1) :args (5))
(step @p23 false :rule eq_resolve :premises (@p22 @p21))
)
