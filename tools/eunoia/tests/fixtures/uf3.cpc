unsat
(
(declare-sort U 0)
(declare-const y U)
(declare-const x U)
(declare-const f (-> U U))
(declare-const z U)
(define @t1 () (f z))
(define @t2 () (f x))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(assume @p1 (and (= x y) (= y z) @t4))
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (@t1))
(step @p4 :rule cong :premises (@p3) :args ((not (= @t1 @t1))))
(step @p5 :rule trans :premises (@p4 @p2))
(step @p6 :rule refl :args (@t1))
(step @p7 :rule and_elim :premises (@p1) :args (1))
(step @p8 :rule and_elim :premises (@p1) :args (0))
(step @p9 :rule trans :premises (@p8 @p7))
(step @p10 :rule cong :premises (@p9) :args (@t2))
(step @p11 :rule cong :premises (@p10 @p6) :args (@t3))
(step @p12 :rule cong :premises (@p11) :args (@t4))
(step @p13 :rule trans :premises (@p12 @p5))
(step @p14 :rule and_elim :premises (@p1) :args (2))
(step @p15 false :rule eq_resolve :premises (@p14 @p13))
)
