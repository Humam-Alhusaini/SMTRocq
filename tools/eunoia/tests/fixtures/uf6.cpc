unsat
(
(declare-sort U 0)
(declare-const f (-> U U U))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (f z y))
(define @t2 () (f z x))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(assume @p1 (= x y))
(assume @p2 @t4)
(step @p3 :rule evaluate :args ((not true)))
(step @p4 :rule eq-refl :args (@t1))
(step @p5 :rule cong :premises (@p4) :args ((not (= @t1 @t1))))
(step @p6 :rule trans :premises (@p5 @p3))
(step @p7 :rule refl :args (@t1))
(step @p8 :rule cong :premises (@p1) :args (@t2))
(step @p9 :rule cong :premises (@p8 @p7) :args (@t3))
(step @p10 :rule cong :premises (@p9) :args (@t4))
(step @p11 :rule trans :premises (@p10 @p6))
(step @p12 false :rule eq_resolve :premises (@p2 @p11))
)
