unsat
(
(declare-const x Int)
(define @t1 () (- x 3))
(define @t2 () (= @t1 7))
(define @t3 () (=> @t2 (<= 10 x)))
(define @t4 () (not @t3))
(define @t5 () (>= 10 10))
(define @t6 () (+ -3 x))
(define @t7 () (* -1 3))
(define @t8 () (+ x @t7))
(define @t9 () (>= x 10))
(assume @p1 @t4)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule evaluate :args (@t5))
(step @p4 :rule cong :premises (@p3) :args ((not @t5)))
(step @p5 :rule trans :premises (@p4 @p2))
(step @p6 :rule refl :args (10))
(step @p7 :rule arith_poly_norm :args ((= (* -10 (- @t6 7)) (* -10 (- x 10)))))
(step @p8 :rule arith_poly_norm_rel :premises (@p7) :args ((= (= @t6 7) (= x 10))))
(step @p9 :rule arith-elim-leq :args (10 x))
(step @p10 :rule refl :args (7))
(step @p11 :rule arith_poly_norm :args ((= (+ x -3) @t6)))
(step @p12 :rule evaluate :args (@t7))
(step @p13 :rule refl :args (x))
(step @p14 :rule nary_cong :premises (@p13 @p12) :args (@t8))
(step @p15 :rule trans :premises (@p14 @p11))
(step @p16 :rule arith_poly_norm :args ((= @t1 @t8)))
(step @p17 :rule trans :premises (@p16 @p15))
(step @p18 :rule cong :premises (@p17 @p10) :args (@t2))
(step @p19 :rule cong :premises (@p18 @p9) :args (@t3))
(step @p20 :rule cong :premises (@p19) :args (@t4))
(step @p21 :rule eq_resolve :premises (@p1 @p20))
(step @p22 :rule not_implies_elim1 :premises (@p21))
(step @p23 :rule eq_resolve :premises (@p22 @p8))
(step @p24 :rule cong :premises (@p23 @p6) :args (@t9))
(step @p25 :rule cong :premises (@p24) :args ((not @t9)))
(step @p26 :rule trans :premises (@p25 @p5))
(step @p27 :rule not_implies_elim2 :premises (@p21))
(step @p28 false :rule eq_resolve :premises (@p27 @p26))
)
