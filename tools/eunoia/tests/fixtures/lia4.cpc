unsat
(
(declare-const x Int)
(declare-const y Int)
(define @t1 () (- y 1))
(define @t2 () (<= x @t1))
(define @t3 () (= (< x y) @t2))
(define @t4 () (not @t3))
(define @t5 () (+ x (* -1 y)))
(define @t6 () (>= @t5 0))
(define @t7 () (* 1 (- @t5 0)))
(define @t8 () (+ -1 y))
(define @t9 () (+ @t8 1))
(define @t10 () (>= x @t9))
(define @t11 () (* -1 1))
(define @t12 () (+ y @t11))
(define @t13 () (>= x y))
(assume @p1 @t4)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args ((not @t6)))
(step @p4 :rule arith_poly_norm :args ((= (* 1 (- x @t9)) @t7)))
(step @p5 :rule arith_poly_norm_rel :premises (@p4) :args ((= @t10 @t6)))
(step @p6 :rule cong :premises (@p5) :args ((not @t10)))
(step @p7 :rule arith-leq-norm :args (x @t8))
(step @p8 :rule trans :premises (@p7 @p6))
(step @p9 :rule arith_poly_norm :args ((= (+ y -1) @t8)))
(step @p10 :rule evaluate :args (@t11))
(step @p11 :rule refl :args (y))
(step @p12 :rule nary_cong :premises (@p11 @p10) :args (@t12))
(step @p13 :rule trans :premises (@p12 @p9))
(step @p14 :rule arith_poly_norm :args ((= @t1 @t12)))
(step @p15 :rule trans :premises (@p14 @p13))
(step @p16 :rule cong :premises (@p15) :args (@t2))
(step @p17 :rule trans :premises (@p16 @p8))
(step @p18 :rule arith_poly_norm :args ((= (* 1 (- x y)) @t7)))
(step @p19 :rule arith_poly_norm_rel :premises (@p18) :args ((= @t13 @t6)))
(step @p20 :rule cong :premises (@p19) :args ((not @t13)))
(step @p21 :rule arith-elim-lt :args (x y))
(step @p22 :rule trans :premises (@p21 @p20))
(step @p23 :rule cong :premises (@p22 @p17) :args (@t3))
(step @p24 :rule trans :premises (@p23 @p3))
(step @p25 :rule cong :premises (@p24) :args (@t4))
(step @p26 :rule trans :premises (@p25 @p2))
(step @p27 false :rule eq_resolve :premises (@p1 @p26))
)
