unsat
(
(declare-sort U 0)
(declare-const a U)
(declare-const c U)
(declare-const p (-> U Bool))
(declare-const b U)
(define @t1 () (p b))
(define @t2 () (and @t1 (p c)))
(define @t3 () (and (p a) @t1))
(define @t4 () (or @t3 @t2))
(assume @p1 (and @t4 (not @t1)))
(step @p2 :rule and_elim :premises (@p1) :args (1))
(step @p3 :rule cnf_and_pos :args (@t2 0))
(step @p4 :rule resolution :premises (@p3 @p2) :args (true @t1))
(step @p5 :rule cnf_and_pos :args (@t3 1))
(step @p6 :rule resolution :premises (@p5 @p2) :args (true @t1))
(step @p7 :rule cnf_or_pos :args (@t4))
(step @p8 :rule chain_resolution :premises (@p7 @p6 @p4) :args ((@list true true) (@list @t3 @t2)))
(step @p9 :rule and_elim :premises (@p1) :args (0))
(step @p10 false :rule contra :premises (@p9 @p8))
)
