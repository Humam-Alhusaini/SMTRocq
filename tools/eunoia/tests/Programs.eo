; Runtime regression signature. These are syntax computations, not SMT rules.
(include "../signatures/Constructors.eo")

(program $checked_flip ((T Type) (x T) (y T))
  :signature (Bool) Bool
  ((($checked_flip (= x y))
    (eo::requires x y (= y x)))))

(program $peel ((F Bool))
  :signature (Bool) Bool
  ((($peel (not F)) ($peel F))
   (($peel F) F)))

(program $choice ((F Bool) (G Bool))
  :signature (Bool Bool) Bool
  ((($choice F G) (eo::ite (eo::eq F G) F G))))

(program $first_match ((F Bool))
  :signature (Bool) Bool
  ((($first_match F) (eo::requires F true F))
   (($first_match F) F)))

(program $predicate ((F Bool))
  :signature (Bool) Bool
  ((($predicate F) true)))

(declare-rule require_equal ((F Bool) (G Bool))
  :args (F G)
  :requires (((eo::eq F G) true))
  :conclusion F)

(declare-rule guarded ((F Bool))
  :premises (F)
  :conclusion ($checked_flip F))

(declare-rule peel ((F Bool))
  :args (F)
  :conclusion ($peel F))

(declare-rule choose ((F Bool) (G Bool))
  :args (F G)
  :conclusion ($choice F G))

(declare-rule inspect ((F Bool))
  :args (F)
  :requires (((eo::typeof F) Bool))
  :conclusion (eo::define ((v F)) v))

(declare-rule first_match ((F Bool))
  :args (F)
  :conclusion ($first_match F))

(declare-rule output_type ((F Bool))
  :args (F)
  :conclusion (not ($predicate F)))

(program $failing ((F Bool)) :signature (Bool) Bool
  ((($failing F) (eo::requires F true F))))
(define $lexical ((F Bool))
  (eo::define ((x true)) F))
(declare-rule unused_failure ((F Bool)) :args (F)
  :conclusion (eo::define ((bad ($failing F))) F))
(declare-rule lazy_branch ((F Bool)) :args (F)
  :conclusion (eo::ite true F ($failing F)))
(declare-rule failed_values_not_equal ((F Bool)) :args (F)
  :conclusion (eo::requires ($failing F) ($failing F) true))
(declare-rule failure_predicates ((F Bool)) :args (F)
  :conclusion (eo::is_eq ($failing F) ($failing F)))
(declare-rule failure_ok ((F Bool)) :args (F)
  :conclusion (eo::is_ok ($failing F)))
(declare-rule definition_capture ((x Bool)) :args (x)
  :conclusion ($lexical x))
(declare-rule parallel_shadow ((x Bool)) :args (x)
  :conclusion (eo::define ((x true) (y x)) y))
