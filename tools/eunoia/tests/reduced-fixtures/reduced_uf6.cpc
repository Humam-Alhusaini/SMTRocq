unsat
(
(declare-sort U 0)
(declare-const f (-> U U U))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (= x y))
(define @t2 () (f z x))
(define @t3 () (= @t2 (f z y)))
(assume @p1 @t1)
(assume @p2 (not @t3))
(assume-push @p10 @t1)
(step @p4 :rule cong :premises (@p1) :args (@t2))
(step-pop @p11 :rule scope :premises (@p4))
(step @p5 :rule process_scope :premises (@p11) :args (@t3))
(step @p7 :rule implies_elim :premises (@p5))
(step @p8 :rule reordering :premises (@p7) :args ((or @t3 (not @t1))))
(step @p9 false :rule chain_m_resolution :premises (@p8 @p1 @p2) :args (false (@list false true) (@list @t1 @t3)))
)
