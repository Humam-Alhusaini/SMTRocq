unsat
(
(declare-sort U 0)
(declare-const y U)
(declare-const x U)
(declare-const f (-> U U))
(declare-const z U)
(define @t1 () (f x))
(define @t2 () (= @t1 (f z)))
(define @t3 () (= y z))
(define @t4 () (= x y))
(define @t5 () (and @t3 @t4))
(assume @p1 (and @t4 @t3 (not @t2)))
(step @p2 :rule and_elim :premises (@p1) :args (2))
(step @p3 :rule and_elim :premises (@p1) :args (1))
(step @p4 :rule and_elim :premises (@p1) :args (0))
(assume-push @p17 @t3)
(assume-push @p18 @t4)
(step @p7 :rule trans :premises (@p4 @p3))
(step @p8 :rule cong :premises (@p7) :args (@t1))
(step-pop @p19 :rule scope :premises (@p8))
(step-pop @p20 :rule scope :premises (@p19))
(step @p9 :rule process_scope :premises (@p20) :args (@t2))
(step @p12 :rule implies_elim :premises (@p9))
(step @p13 :rule cnf_and_neg :args (@t5))
(step @p14 :rule resolution :premises (@p13 @p12) :args (true @t5))
(step @p15 :rule reordering :premises (@p14) :args ((or @t2 (not @t4) (not @t3))))
(step @p16 false :rule chain_m_resolution :premises (@p15 @p4 @p3 @p2) :args (false (@list false false true) (@list @t4 @t3 @t2)))
)
