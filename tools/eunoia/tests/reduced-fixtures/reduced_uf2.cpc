unsat
(
(declare-sort U 0)
(declare-const a U)
(declare-const c U)
(declare-const p (-> U Bool))
(declare-const b U)
(define @t1 () (p b))
(define @t2 () (and @t1 (p c)))
(define @t3 () (and (p a) @t1))
(define @t4 () (not @t3))
(define @t5 () (@list true))
(define @t6 () (@list @t1))
(define @t7 () (not @t2))
(assume @p1 (and (or @t3 @t2) (not @t1)))
(step @p2 :rule and_elim :premises (@p1) :args (1))
(step @p3 :rule cnf_and_pos :args (@t3 1))
(step @p4 :rule reordering :premises (@p3) :args ((or @t1 @t4)))
(step @p5 :rule chain_m_resolution :premises (@p4 @p2) :args (@t4 @t5 @t6))
(step @p6 :rule cnf_and_pos :args (@t2 0))
(step @p7 :rule reordering :premises (@p6) :args ((or @t1 @t7)))
(step @p8 :rule chain_m_resolution :premises (@p7 @p2) :args (@t7 @t5 @t6))
(step @p9 :rule and_elim :premises (@p1) :args (0))
(step @p10 false :rule chain_m_resolution :premises (@p9 @p8 @p5) :args (false (@list true true) (@list @t2 @t3)))
)
