unsat
(
(declare-const x Int)
(define @t1 () (- x 3))
(define @t2 () (= @t1 7))
(define @t3 () (=> @t2 (<= 10 x)))
(define @t4 () (not @t3))
(define @t5 () (>= x 10))
(define @t6 () (+ -3 x))
(define @t7 () (>= @t6 7))
(define @t8 () (+ 7 1))
(define @t9 () (>= @t6 @t8))
(define @t10 () (<= @t6 7))
(define @t11 () (and @t10 @t7))
(define @t12 () (=> @t11 @t5))
(define @t13 () (=> (= @t6 7) @t5))
(define @t14 () (* -1 3))
(define @t15 () (+ x @t14))
(assume @p1 @t4)
(step @p2 :rule refl :args (@t5))
(step @p3 :rule arith_poly_norm :args ((= (* -10 (- @t6 7)) (* -10 (- x 10)))))
(step @p4 :rule arith_poly_norm_rel :premises (@p3) :args ((= @t7 @t5)))
(step @p5 :rule arith_poly_norm :args ((= (* -11 (- @t6 @t8)) (* -11 (- x 11)))))
(step @p6 :rule arith_poly_norm_rel :premises (@p5) :args ((= @t9 (>= x 11))))
(step @p7 :rule cong :premises (@p6) :args ((not @t9)))
(step @p8 :rule arith-leq-norm :args (@t6 7))
(step @p9 :rule trans :premises (@p8 @p7))
(step @p10 :rule nary_cong :premises (@p9 @p4) :args (@t11))
(step @p11 :rule cong :premises (@p10 @p2) :args (@t12))
(step @p12 :rule cong :premises (@p11) :args ((not @t12)))
(step @p13 :rule aci_norm :args ((= (and @t7 @t10) @t11)))
(step @p14 :rule arith-eq-elim-int :args (@t6 7))
(step @p15 :rule trans :premises (@p14 @p13))
(step @p16 :rule cong :premises (@p15 @p2) :args (@t13))
(step @p17 :rule cong :premises (@p16) :args ((not @t13)))
(step @p18 :rule arith-elim-leq :args (10 x))
(step @p19 :rule refl :args (7))
(step @p20 :rule arith_poly_norm :args ((= (+ x -3) @t6)))
(step @p21 :rule evaluate :args (@t14))
(step @p22 :rule refl :args (x))
(step @p23 :rule nary_cong :premises (@p22 @p21) :args (@t15))
(step @p24 :rule trans :premises (@p23 @p20))
(step @p25 :rule arith_poly_norm :args ((= @t1 @t15)))
(step @p26 :rule trans :premises (@p25 @p24))
(step @p27 :rule cong :premises (@p26 @p19) :args (@t2))
(step @p28 :rule cong :premises (@p27 @p18) :args (@t3))
(step @p29 :rule cong :premises (@p28) :args (@t4))
(step @p30 :rule trans :premises (@p29 @p17 @p12))
(step @p31 :rule eq_resolve :premises (@p1 @p30))
(step @p32 :rule not_implies_elim1 :premises (@p31))
(step @p33 :rule and_elim :premises (@p32) :args (1))
(step @p34 :rule not_implies_elim2 :premises (@p31))
(step @p35 false :rule chain_m_resolution :premises (@p34 @p33) :args (false (@list false) (@list @t5)))
)
