unsat
(
(declare-sort U 0)
(declare-const c U)
(declare-const f (-> U U))
(declare-const a U)
(declare-const p (-> U Bool))
(declare-const b U)
(define @t1 () (p b))
(define @t2 () (not @t1))
(define @t3 () (p a))
(define @t4 () (and @t3 @t2))
(define @t5 () (f a))
(define @t6 () (= @t5 (f b)))
(define @t7 () (= b c))
(define @t8 () (= a c))
(define @t9 () (@list false))
(define @t10 () (not @t4))
(define @t11 () (@list @t4))
(define @t12 () (and @t3 @t8 @t7))
(assume @p1 (and @t8 @t7 (or (not @t6) @t4)))
(step @p2 :rule and_elim :premises (@p1) :args (1))
(step @p3 :rule symm :premises (@p2))
(step @p4 :rule and_elim :premises (@p1) :args (0))
(step @p5 :rule trans :premises (@p4 @p3))
(step @p6 :rule cong :premises (@p5) :args (@t5))
(step @p7 :rule and_elim :premises (@p1) :args (2))
(step @p8 :rule chain_m_resolution :premises (@p7 @p6) :args (@t4 @t9 (@list @t6)))
(step @p9 :rule cnf_and_pos :args (@t4 1))
(step @p10 :rule reordering :premises (@p9) :args ((or @t2 @t10)))
(step @p11 :rule chain_m_resolution :premises (@p10 @p8) :args (@t2 @t9 @t11))
(step @p12 :rule cnf_and_pos :args (@t4 0))
(step @p13 :rule reordering :premises (@p12) :args ((or @t3 @t10)))
(step @p14 :rule chain_m_resolution :premises (@p13 @p8) :args (@t3 @t9 @t11))
(assume-push @p33 @t3)
(assume-push @p34 @t8)
(assume-push @p35 @t7)
(step @p18 :rule true_intro :premises (@p14))
(step @p19 :rule symm :premises (@p4))
(step @p20 :rule trans :premises (@p2 @p19))
(step @p21 :rule cong :premises (@p20) :args (@t1))
(step @p22 :rule trans :premises (@p21 @p18))
(step @p23 :rule true_elim :premises (@p22))
(step-pop @p36 :rule scope :premises (@p23))
(step-pop @p37 :rule scope :premises (@p36))
(step-pop @p38 :rule scope :premises (@p37))
(step @p24 :rule process_scope :premises (@p38) :args (@t1))
(step @p28 :rule implies_elim :premises (@p24))
(step @p29 :rule cnf_and_neg :args (@t12))
(step @p30 :rule resolution :premises (@p29 @p28) :args (true @t12))
(step @p31 :rule reordering :premises (@p30) :args ((or @t1 (not @t8) (not @t7) (not @t3))))
(step @p32 false :rule chain_m_resolution :premises (@p31 @p2 @p4 @p14 @p11) :args (false (@list false false false true) (@list @t7 @t8 @t3 @t1)))
)
