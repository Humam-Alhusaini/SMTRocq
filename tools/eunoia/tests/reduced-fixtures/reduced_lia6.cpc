unsat
(
(declare-const x Int)
(define @t1 () (>= x 10))
(define @t2 () (- x 3))
(define @t3 () (<= 7 @t2))
(define @t4 () (<= @t2 7))
(define @t5 () (and @t4 @t3))
(define @t6 () (=> @t5 @t1))
(define @t7 () (not @t6))
(define @t8 () (+ -3 x))
(define @t9 () (* -1 3))
(define @t10 () (+ x @t9))
(define @t11 () (+ 7 1))
(define @t12 () (>= @t8 @t11))
(assume @p1 @t7)
(step @p2 :rule refl :args (@t1))
(step @p3 :rule arith_poly_norm :args ((= (* -10 (- @t8 7)) (* -10 (- x 10)))))
(step @p4 :rule arith_poly_norm_rel :premises (@p3) :args ((= (>= @t8 7) @t1)))
(step @p5 :rule arith-elim-leq :args (7 @t8))
(step @p6 :rule trans :premises (@p5 @p4))
(step @p7 :rule arith_poly_norm :args ((= (+ x -3) @t8)))
(step @p8 :rule evaluate :args (@t9))
(step @p9 :rule refl :args (x))
(step @p10 :rule nary_cong :premises (@p9 @p8) :args (@t10))
(step @p11 :rule trans :premises (@p10 @p7))
(step @p12 :rule arith_poly_norm :args ((= @t2 @t10)))
(step @p13 :rule trans :premises (@p12 @p11))
(step @p14 :rule cong :premises (@p13) :args (@t3))
(step @p15 :rule trans :premises (@p14 @p6))
(step @p16 :rule arith_poly_norm :args ((= (* -11 (- @t8 @t11)) (* -11 (- x 11)))))
(step @p17 :rule arith_poly_norm_rel :premises (@p16) :args ((= @t12 (>= x 11))))
(step @p18 :rule cong :premises (@p17) :args ((not @t12)))
(step @p19 :rule arith-leq-norm :args (@t8 7))
(step @p20 :rule trans :premises (@p19 @p18))
(step @p21 :rule refl :args (7))
(step @p22 :rule cong :premises (@p13 @p21) :args (@t4))
(step @p23 :rule trans :premises (@p22 @p20))
(step @p24 :rule nary_cong :premises (@p23 @p15) :args (@t5))
(step @p25 :rule cong :premises (@p24 @p2) :args (@t6))
(step @p26 :rule cong :premises (@p25) :args (@t7))
(step @p27 :rule eq_resolve :premises (@p1 @p26))
(step @p28 :rule not_implies_elim1 :premises (@p27))
(step @p29 :rule and_elim :premises (@p28) :args (1))
(step @p30 :rule not_implies_elim2 :premises (@p27))
(step @p31 false :rule chain_m_resolution :premises (@p30 @p29) :args (false (@list false) (@list @t1)))
)
