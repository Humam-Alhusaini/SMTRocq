unsat
(
(declare-sort U 0)
(declare-const f (-> U U))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (= x y))
(define @t2 () (f x))
(define @t3 () (= @t2 (f y)))
(assume @p1 (and (not @t3) (= y z) (= @t2 (f (f z))) @t1))
(step @p2 :rule and_elim :premises (@p1) :args (0))
(step @p3 :rule and_elim :premises (@p1) :args (3))
(assume-push @p11 @t1)
(step @p5 :rule cong :premises (@p3) :args (@t2))
(step-pop @p12 :rule scope :premises (@p5))
(step @p6 :rule process_scope :premises (@p12) :args (@t3))
(step @p8 :rule implies_elim :premises (@p6))
(step @p9 :rule reordering :premises (@p8) :args ((or @t3 (not @t1))))
(step @p10 false :rule chain_m_resolution :premises (@p9 @p3 @p2) :args (false (@list false true) (@list @t1 @t3)))
)
