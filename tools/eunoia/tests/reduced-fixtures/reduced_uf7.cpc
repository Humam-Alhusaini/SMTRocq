unsat
(
(declare-sort U 0)
(declare-const P (-> U U Bool))
(declare-const z U)
(declare-const x U)
(declare-const y U)
(define @t1 () (= x y))
(define @t2 () (P z x))
(define @t3 () (P z y))
(define @t4 () (and @t2 @t1))
(assume @p1 @t1)
(assume @p2 @t2)
(assume @p3 (not @t3))
(assume-push @p19 @t2)
(assume-push @p20 @t1)
(step @p6 :rule true_intro :premises (@p2))
(step @p7 :rule symm :premises (@p1))
(step @p8 :rule cong :premises (@p7) :args (@t3))
(step @p9 :rule trans :premises (@p8 @p6))
(step @p10 :rule true_elim :premises (@p9))
(step-pop @p21 :rule scope :premises (@p10))
(step-pop @p22 :rule scope :premises (@p21))
(step @p11 :rule process_scope :premises (@p22) :args (@t3))
(step @p14 :rule implies_elim :premises (@p11))
(step @p15 :rule cnf_and_neg :args (@t4))
(step @p16 :rule resolution :premises (@p15 @p14) :args (true @t4))
(step @p17 :rule reordering :premises (@p16) :args ((or @t3 (not @t1) (not @t2))))
(step @p18 false :rule chain_m_resolution :premises (@p17 @p1 @p2 @p3) :args (false (@list false false true) (@list @t1 @t2 @t3)))
)
