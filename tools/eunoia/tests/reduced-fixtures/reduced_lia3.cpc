unsat
(
(declare-const y Int)
(declare-const x Int)
(define @t1 () (+ y 1))
(define @t2 () (<= @t1 x))
(define @t3 () (=> (> x y) @t2))
(define @t4 () (not @t3))
(define @t5 () (+ x (* -1 y)))
(define @t6 () (* -1 (- @t5 1)))
(define @t7 () (+ 1 y))
(define @t8 () (>= @t5 1))
(define @t9 () (>= x @t1))
(assume @p1 @t4)
(step @p2 :rule arith_poly_norm :args ((= (* -1 (- x @t7)) @t6)))
(step @p3 :rule arith_poly_norm_rel :premises (@p2) :args ((= (>= x @t7) @t8)))
(step @p4 :rule arith-elim-leq :args (@t7 x))
(step @p5 :rule trans :premises (@p4 @p3))
(step @p6 :rule refl :args (x))
(step @p7 :rule arith_poly_norm :args ((= @t1 @t7)))
(step @p8 :rule cong :premises (@p7 @p6) :args (@t2))
(step @p9 :rule trans :premises (@p8 @p5))
(step @p10 :rule bool-double-not-elim :args (@t8))
(step @p11 :rule arith_poly_norm :args ((= (* -1 (- x @t1)) @t6)))
(step @p12 :rule arith_poly_norm_rel :premises (@p11) :args ((= @t9 @t8)))
(step @p13 :rule cong :premises (@p12) :args ((not @t9)))
(step @p14 :rule arith-leq-norm :args (x y))
(step @p15 :rule trans :premises (@p14 @p13))
(step @p16 :rule cong :premises (@p15) :args ((not (<= x y))))
(step @p17 :rule trans :premises (@p16 @p10))
(step @p18 :rule arith-elim-leq :args (x y))
(step @p19 :rule symm :premises (@p18))
(step @p20 :rule cong :premises (@p19) :args ((not (>= y x))))
(step @p21 :rule arith-elim-gt :args (x y))
(step @p22 :rule trans :premises (@p21 @p20))
(step @p23 :rule trans :premises (@p22 @p17))
(step @p24 :rule cong :premises (@p23 @p9) :args (@t3))
(step @p25 :rule cong :premises (@p24) :args (@t4))
(step @p26 :rule eq_resolve :premises (@p1 @p25))
(step @p27 :rule not_implies_elim1 :premises (@p26))
(step @p28 :rule not_implies_elim2 :premises (@p26))
(step @p29 false :rule chain_m_resolution :premises (@p28 @p27) :args (false (@list false) (@list @t8)))
)
