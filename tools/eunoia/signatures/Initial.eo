; Extracted without semantic changes from cvc5 1.4.2 CPC. See README.md.
(include "Constructors.eo")

(program $mk_symm ((T Type) (t1 T) (t2 T)) :signature (Bool) Bool ((($mk_symm (= t1 t2)) (= t2 t1)) (($mk_symm (not (= t1 t2))) (not (= t2 t1)))))

(declare-rule contra ((F Bool)) :premises (F (not F)) :conclusion false)

(declare-rule eq-refl ((@T0 Type) (t1 @T0)) :args (t1) :conclusion (= (= t1 t1) true))

(declare-rule eq-symm ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1)) :args (t1 s1) :conclusion (= (= t1 s1) (= s1 t1)))

(declare-rule eq_resolve ((F1 Bool) (F2 Bool)) :premises (F1 (= F1 F2)) :conclusion F2)

(declare-rule false_elim ((F Bool)) :premises ((= F false)) :conclusion (not F))

(declare-rule false_intro ((F Bool)) :premises ((not F)) :conclusion (= F false))

(declare-rule ite_eq ((T Type) (b Bool) (t1 T) (t2 T)) :args ((ite b t1 t2)) :conclusion (eo::define ((k (ite b t1 t2))) (ite b (= k t1) (= k t2))))

(declare-rule modus_ponens ((F1 Bool) (F2 Bool)) :premises (F1 (=> F1 F2)) :conclusion F2)

(declare-rule not_not_elim ((F Bool)) :premises ((not (not F))) :conclusion F)

(declare-rule refl ((T Type) (t T)) :args (t) :conclusion (= t t))

(declare-rule symm ((F Bool)) :premises (F) :conclusion ($mk_symm F))

(declare-rule true_elim ((F Bool)) :premises ((= F true)) :conclusion F)

(declare-rule true_intro ((F Bool)) :premises (F) :conclusion (= F true))
