# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "SMTRocq: a CVC5-backed SMT tactic built on SMTCoq"
description:
  "SMTRocq builds upon SMTCoq's verified theory semantics, reflective proof checkers, and Rocq preprocessing. It adds a CVC5 backend that translates untrusted solver proofs into compact checked certificates. The Eunoia/CPC checker is maintained separately in rocq-eunoia-checker and consumed as a pinned source dependency. Existing SMTCoq logical names are retained for compatibility."
maintainer: ["Humam-Alhusaini"]
authors: [
  "Michaël Armand"
  "Valentin Blot"
  "Amina Bousalem"
  "Quentin Garchery"
  "Benjamin Grégoire"
  "Chantal Keller"
  "Burak Ekici"
  "Alain Mebsout"
]
license: "CECILL-C"
tags: [
  "category:Computer Science/Decision Procedures and Certified Algorithms/Decision procedures"
  "category:Miscellaneous/Coq Extensions"
  "keyword: SMT"
  "keyword: SAT"
  "keyword: automation"
  "logpath:SMTCoq"
]
homepage: "https://github.com/Humam-Alhusaini/SMTRocq"
bug-reports: "https://github.com/Humam-Alhusaini/SMTRocq/issues"
depends: [
  "dune" {>= "3.21"}
  "conf-python-3"
  "num"
  "rocq-core" {>= "9.2.0"}
  "rocq-stdlib"
  "rocq-trakt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Humam-Alhusaini/SMTRocq.git"
x-maintenance-intent: ["(latest)"]
pin-depends: [
  ["rocq-trakt.dev" "git+https://github.com/rocq-trakt/trakt"]
]
messages: "
  SMTRocq builds upon SMTCoq and retains its package/logical names for compatibility.
  Initialize the pinned checker dependency with git submodule update --init --recursive.
  Install the private CVC5 toolchain with python3 scripts/eunoia/install_toolchain.py.
  Project and legacy-solver setup: https://github.com/Humam-Alhusaini/SMTRocq/blob/main/INSTALL.md
"
