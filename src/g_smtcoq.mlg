DECLARE PLUGIN "rocq-smtcoq.smtcoq"

{

open Stdarg
open Ltac_plugin
open Common

}

VERNAC COMMAND EXTEND Vernac_zchaff CLASSIFIED AS QUERY
| [ "Parse_certif_zchaff" 
    ident(dimacs) ident(trace) string(fdimacs) string(fproof) ] ->
  {
    Zchaff.parse_certif dimacs trace fdimacs fproof
  }
| [ "Zchaff_Checker" string(fdimacs) string(fproof) ] ->
  {
    Zchaff.checker fdimacs fproof
  }
| [ "Zchaff_Theorem" ident(name) string(fdimacs) string(fproof) ] ->
  {
    Zchaff.theorem name fdimacs fproof
  }
END

VERNAC COMMAND EXTEND Vernac_verit CLASSIFIED AS QUERY
| [ "Parse_certif_verit"
    ident(t_i) ident(t_func) ident(t_atom) ident(t_form) ident(root) ident(used_roots) ident(trace) string(fsmt) string(fproof) ] ->
  {
    Verit.parse_certif t_i t_func t_atom t_form root used_roots trace fsmt fproof
  }
| [ "Verit_Checker" string(fsmt) string(fproof) ] ->
  {
    Verit.checker fsmt fproof
  }
| [ "Verit_Checker_Debug" string(fsmt) string(fproof) ] ->
  {
    Verit.checker_debug fsmt fproof
  }
| [ "Verit_Theorem" ident(name) string(fsmt) string(fproof) ] ->
  {
    Verit.theorem name fsmt fproof
  }
END

VERNAC COMMAND EXTEND Vernac_lfsc CLASSIFIED AS QUERY
| [ "Parse_certif_lfsc"
    ident(t_i) ident(t_func) ident(t_atom) ident(t_form) ident(root) ident(used_roots) ident(trace) string(fsmt) string(fproof) ] ->
  {
    Lfsc.parse_certif t_i t_func t_atom t_form root used_roots trace fsmt fproof
  }
| [ "Lfsc_Checker" string(fsmt) string(fproof) ] ->
  {
    Lfsc.checker fsmt fproof
  }
| [ "Lfsc_Checker_Debug" string(fsmt) string(fproof) ] ->
  {
    Lfsc.checker_debug fsmt fproof
  }
| [ "Lfsc_Theorem" ident(name) string(fsmt) string(fproof) ] ->
  {
    Lfsc.theorem name fsmt fproof
  }
END

TACTIC EXTEND Tactic_zchaff
| [ "zchaff_bool" ] -> { Zchaff.tactic () }
| [ "zchaff_bool_no_check" ] -> { Zchaff.tactic_no_check () }
END

{

let lemmas_list = RocqVersionCompat.Summary.ref ~name:"Selected lemmas" []

let cache_lemmas lems =
  let open RocqVersionCompat.Summary.Ref in
  lemmas_list := lems

let declare_lemmas : RocqVersionCompat.constr_expr list -> Libobject.obj =
  let open Libobject in
  let obj =
    {
      (default_object "LEMMAS") with
      cache_function = cache_lemmas;
      load_function = (fun _ -> cache_lemmas);
    }
  in
  declare_object obj

let add_lemmas lems =
  let open RocqVersionCompat.Summary.Ref in
  Lib.add_leaf (declare_lemmas (lems @ !lemmas_list))

let clear_lemmas () =
  Lib.add_leaf (declare_lemmas [])

let get_lemmas () =
  let open RocqVersionCompat.Summary.Ref in
  !lemmas_list

}

VERNAC COMMAND EXTEND Add_lemma CLASSIFIED AS SIDEFF
| [ "Add_lemmas" constr_list(lems) ] -> { add_lemmas lems }
| [ "Clear_lemmas" ] -> { clear_lemmas () }
END


TACTIC EXTEND Tactic_verit
| [ "verit_bool_base" constr(lpl) ] -> { Verit.tactic None lpl (get_lemmas ()) }
| [ "verit_bool_no_check_base" constr(lpl) ] -> { Verit.tactic_no_check None lpl (get_lemmas ()) }
| [ "verit_bool_base_timeout" constr(lpl) int_or_var(timeout) ] -> { Verit.tactic (Some timeout) lpl (get_lemmas ()) }
| [ "verit_bool_no_check_base_timeout" constr(lpl) int_or_var(timeout) ] -> { Verit.tactic_no_check (Some timeout) lpl (get_lemmas ()) }
END

TACTIC EXTEND Tactic_cvc4
| [ "cvc4_bool" ] -> { Lfsc.tactic () }
| [ "cvc4_bool_no_check" ] -> { Lfsc.tactic_no_check () }
| [ "cvc5_bool_abduct" int_or_var(i) constr(lpl) ] -> { Lfsc.tactic_abduct i lpl (get_lemmas ()) }
END

{

let compact_theory_candidate candidate =
  let data = Eunoia_witness.Theory.to_coq
    ~constructor:(fun name -> Eunoia_backend.EunoiaRocq.global
      ("SMTCoq.checker.eunoia.EunoiaTheory.EunoiaTheory." ^ name)) candidate in
  RocqInterface.mkApp
    (Eunoia_backend.EunoiaRocq.global "SMTCoq.checker.eunoia.EunoiaMemo.EunoiaMemo.Theory",[|data|])

let compress_goal ~atoms ~forms ~premises ~conclusion =
  match Eunoia_witness.Theory.compress ~premises ~conclusion with
  | Some candidate -> Ok (compact_theory_candidate candidate)
  | None ->
    match Eunoia_witness.Search.compress_uf ~atoms ~forms ~premises ~conclusion () with
    | Error error -> Error (Eunoia_witness.Search.string_of_failure error)
    | Ok witness ->
      let data = Eunoia_witness.Certificate.to_coq
        ~local:(fun name -> Eunoia_backend.EunoiaRocq.global
          ("SMTCoq.checker.eunoia.EunoiaLocal.EunoiaLocal." ^ name))
        ~step:(fun name -> Eunoia_backend.EunoiaRocq.global
          ("SMTCoq.checker.MainChecker.Checker_Ext." ^ name)) witness in
      Ok (RocqInterface.mkApp
        (Eunoia_backend.EunoiaRocq.global "SMTCoq.checker.eunoia.EunoiaMemo.EunoiaMemo.Inline",[|data|]))

let make_eunoia_witness ?(compact=false) () =
  let candidates = Hashtbl.create 127 in
  let owner = ref None in
  let enabled = Sys.getenv_opt "EUNOIA_DISABLE_WITNESS_CACHE" <> Some "1" in
  fun ~atoms ~forms ~premises ~conclusion ->
  (* A tactic expression may be reused on multiple goals. IDs are meaningful
     only in their owning tables, so never reuse candidates across them. *)
  (match !owner with
   | Some (old_atoms,old_forms) when old_atoms == atoms && old_forms == forms -> ()
   | _ -> Hashtbl.clear candidates; owner := Some (atoms,forms));
  let key = List.map (List.map SmtAtom.Form.to_lit) premises,
    List.map SmtAtom.Form.to_lit conclusion in
  let cached = if enabled then Hashtbl.find_opt candidates key else None in
  match cached with
  | Some candidate -> Ok candidate
  | None ->
  let theory_enabled = match Sys.getenv_opt "EUNOIA_THEORY_CERTIFICATES" with
    | Some "0" -> false | Some "1" -> true | _ -> compact in
  let theory = compact_theory_candidate in
  let direct_candidate = if theory_enabled then
    Eunoia_witness.Theory.select ~premises ~conclusion else None in
  let result = match direct_candidate with
  | Some candidate -> Ok (theory candidate)
  | None ->
    let direct, result =
      if Sys.getenv_opt "EUNOIA_DIRECT_CERTIFICATES" = Some "1" then
        match Eunoia_witness.Search.produce_derivation ~atoms ~forms ~premises ~conclusion () with
        | Ok candidate -> true, Ok candidate
        | Error _ -> false, Eunoia_witness.Search.produce ~atoms ~forms ~premises ~conclusion ()
      else false, Eunoia_witness.Search.produce ~atoms ~forms ~premises ~conclusion () in
    match result with
    | Error error -> Error (Eunoia_witness.Search.string_of_failure error)
    | Ok original ->
      let primitive = if theory_enabled then Eunoia_witness.Theory.from_witness
        ~premises:(List.map (List.map SmtAtom.Form.to_lit) premises)
        ~conclusion:(List.map SmtAtom.Form.to_lit conclusion) original else None in
      (match primitive with
      | Some candidate -> Ok (theory candidate)
      | None ->
        let candidate = Eunoia_witness.Certificate.to_coq
          ~local:(fun name -> Eunoia_backend.EunoiaRocq.global
            ("SMTCoq.checker.eunoia.EunoiaLocal.EunoiaLocal." ^ name))
          ~step:(fun name -> Eunoia_backend.EunoiaRocq.global
            ("SMTCoq.checker.MainChecker.Checker_Ext." ^ name)) original in
        (* Tables only grow during this invocation. Reuse producer data with
           identical ordered clauses; every source occurrence still goes
           through the complete generated checker and local semantic gate. *)
        let candidate = if direct then RocqInterface.mkApp
          (Eunoia_backend.EunoiaRocq.global "SMTCoq.checker.eunoia.EunoiaMemo.EunoiaMemo.Direct",[|candidate|]) else candidate in
        Ok candidate) in
  match result with
  | Error error -> Error error
  | Ok candidate ->
      if enabled && Hashtbl.length candidates < 256 then Hashtbl.replace candidates key candidate;
      Ok candidate

let eunoia_tactic ~compiled lpl =
  let lpl = EConstr.Unsafe.to_constr lpl in
  let lemmas = match CoqTerms.option_of_constr_option lpl with
    | None -> []
    | Some tuple -> CoqTerms.list_of_constr_tuple tuple
  in
  let witness = make_eunoia_witness ~compact:compiled () in
  if compiled then Eunoia_backend.EunoiaBackend.tactic_smtcoq ~compression:compress_goal ~witness ~lemmas ()
  else Eunoia_backend.EunoiaBackend.tactic ~witness ~lemmas ()

}

TACTIC EXTEND Tactic_cvc5_eunoia
| [ "cvc5_eunoia_bool_base" constr(lpl) ] -> { eunoia_tactic ~compiled:false lpl }
| [ "cvc5_smtcoq_bool_base" constr(lpl) ] -> { eunoia_tactic ~compiled:true lpl }
END
